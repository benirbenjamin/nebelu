generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  createdAt DateTime @default(now())
  requests ServiceRequest[]
}
model OtpCode {
  id String @id @default(cuid())
  email String
  codeHash String
  expiresAt DateTime
  attempts Int @default(0)
  createdAt DateTime @default(now())
  @@index([email, createdAt])
}
model ServiceRequest {
  id String @id @default(cuid())
  reference String @unique
  userId String
  user User @relation(fields: [userId], references: [id])
  serviceGroup String
  serviceName String
  description String
  cataloguePrice Int
  requestedPrice Int?
  agreedPrice Int?
  status String @default("SUBMITTED")
  decisionNote String?
  reportUrl String?
  reportTitle String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activities Activity[]
  negotiations PriceNegotiation[]
}
model Activity {
  id String @id @default(cuid())
  requestId String
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status String?
  title String
  message String
  imageUrl String?
  createdAt DateTime @default(now())
}
model PriceNegotiation {
  id String @id @default(cuid())
  requestId String
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proposed Int
  reason String
  decision String @default("PENDING")
  approvedAmount Int?
  adminNote String?
  createdAt DateTime @default(now())
}
